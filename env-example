# [OWASP ZAP configuration]
# Active Scan concurrency for security:zap-hud, defaults live in this plugin's .env (2 / 0ms)
# keep conservative, the zaproxy container is memory-capped - uncomment to override
#ZAP_ASCAN_THREADS_PER_HOST=2
#ZAP_ASCAN_DELAY_MS=0
# DOM XSS (scanner 40026) is uniquely expensive - a real browser per test case,
# and the sole bottleneck confirmed blocking a full scan against a DOM-heavy
# app. Default LOW keeps --full scans tractable; raise it here only if you
# want site-wide MEDIUM/HIGH DOM XSS coverage from the CLI (expect it to take
# much longer) - a scoped manual Active Scan via security:zap-hud is usually the
# better way to go deeper on this specific rule.
#ZAP_ASCAN_DOMXSS_STRENGTH=LOW
# Database-specific injection rules to run, comma-separated (mysql, postgresql,
# oracle, mssql, hypersonic, sqlite, mongodb). Rules for other databases are
# disabled - their time-based probes can't find anything and are slow. Empty
# (the default in this plugin's .env) runs them all. The generic SQL Injection rule
# always runs.
#ZAP_ASCAN_DATABASES=mysql

# Password for security:zap-context's CLI-flag config generation (--site-url,
# --login-url, --username, etc. - see security:zap-context --help). Deliberately
# not a --password flag, to keep it out of shell history/process listings.
# No sensible shared default (every target's demo account differs), so
# unlike the settings above this is set here only, never in this plugin's .env -
# that file is tracked by git, this is a credential even if a low-stakes one.
#ZAP_TARGET_PASSWORD=
# How long `security:zap-scan --full` waits for the active scan before giving up
# and generating a report anyway - the scan keeps running server-side
# regardless, this is just the CLI's own patience. Default 1800s (30 min),
# defaults live in this plugin's .env - raise if your target is larger/slower.
#ZAP_ASCAN_TIMEOUT_SECONDS=1800

# container resource caps, defaults live inline in this plugin's docker-compose.yml
# (5g / 4 cores / cores 0-3) - uncomment and adjust to fit your machine
#ZAP_MEM_LIMIT=5g
#ZAP_CPUS=4
#ZAP_CPUSET=0,1,2,3


# the hostname ZAP reaches the target site on - an nginx plugin setting (its
# network alias, default default.test), listed here because security:zap-hud depends on it.
# Set it to the exact hostname you're scanning (it must be in that site's nginx vhost
# server_name), then `php my-sites-ide servers:nginx-start` - the alias is fixed at container creation
#IDE_SITE_ALIAS=default.test
